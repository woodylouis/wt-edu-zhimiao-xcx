{
	"name": "wtdb-wechat-reminder-cron",
	"dependencies": {
		"wechat-subscribe-service": "file:../common/wechat-subscribe-service"
	},
	"cloudfunction-config": {
		"concurrency": 1,
		"memorySize": 512,
		"timeout": 600,
		"triggers": [
			{
				"name": "wechat-reminder-daily",
				"type": "timer",
				"config": "0 1 0 * * * *"
			}
		]
	}
}
