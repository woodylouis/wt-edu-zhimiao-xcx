{
    "bsonType": "object",
    "required": [
        "assessmentId",
        "childId",
        "childName",
        "childAge",
        "classId",
        "className",
        "completionTime",
        "startTimestamp",
        "duration",
        "totalScore",
        "sectionScores",
        "questions",
        "answers",
        "uuid"
    ],
    "properties": {
        "assessmentId": {
            "bsonType": "string",
            "description": "评估量表ID"
        },
        "childId": {
            "bsonType": "string",
            "description": "儿童唯一标识"
        },
        "childName": {
            "bsonType": "string",
            "description": "儿童姓名"
        },
        "childAge": {
            "bsonType": "number",
            "minimum": 0,
            "description": "儿童年龄（精确到小数点后一位）"
        },
        "classId": {
            "bsonType": "string",
            "description": "班级ID"
        },
        "className": {
            "bsonType": "string",
            "description": "班级名称"
        },
        "completionTime": {
            "bsonType": "timestamp",
            "description": "评估完成时间"
        },
        "startTimestamp": {
            "bsonType": "timestamp",
            "description": "评估开始时间"
        },
        "lastUpdated": {
            "bsonType": "timestamp",
            "description": "最后修改时间"
        },
        "currentIndex": {
            "bsonType": "int",
            "description": "当前题目"
        },
        "duration": {
            "bsonType": "int",
            "minimum": 0,
            "description": "评估耗时（毫秒）"
        },
        "totalScore": {
            "bsonType": "int",
            "minimum": 0,
            "description": "评估总分"
        },
        "sectionScores": {
            "bsonType": "object",
            "additionalProperties": {
                "bsonType": "int",
                "minimum": 0
            },
            "description": "各维度得分（键为维度名称，值为分数）"
        },
        "questions": {
            "bsonType": "array",
            "items": {
                "bsonType": "object",
                "required": [
                    "_id",
                    "assessment_id",
                    "content",
                    "section"
                ],
                "properties": {
                    "_id": {
                        "bsonType": "string"
                    },
                    "assessment_id": {
                        "bsonType": "string"
                    },
                    "order": {
                        "bsonType": "int"
                    },
                    "type": {
                        "bsonType": "string"
                    },
                    "content": {
                        "bsonType": "string"
                    },
                    "section": {
                        "bsonType": "string"
                    },
                    "options": {
                        "bsonType": "array",
                        "items": {
                            "bsonType": "object",
                            "properties": {
                                "score": {
                                    "bsonType": "int"
                                },
                                "text": {
                                    "bsonType": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "answers": {
            "bsonType": "object",
            "additionalProperties": {
                "bsonType": "object",
                "required": [
                    "score"
                ],
                "properties": {
                    "score": {
                        "bsonType": "int"
                    },
                    "question": {
                        "bsonType": "object",
                        "description": "题目快照"
                    }
                }
            }
        },
        "uuid": {
            "bsonType": "string",
            "description": "评估记录唯一标识"
        }
    }
}