{
    "bsonType": "object",
    "required": [
        "assessmentId",
        "childId",
        "childName",
        "childAge",
        "classId",
        "className",
        "completionTime",
        "startTimestamp",
        "duration",
        "totalScore",
        "sectionScores",
        "questions",
        "answers",
        "uuid"
    ],
    "properties": {
        "assessmentId": {
            "bsonType": "string",
            "description": "评估量表ID"
        },
        "childId": {
            "bsonType": "string",
            "description": "儿童唯一标识"
        },
        "childName": {
            "bsonType": "string",
            "description": "儿童姓名"
        },
        "childAge": {
            "bsonType": "number",
            "description": "儿童年龄（如3.7岁）"
        },
        "classId": {
            "bsonType": "string",
            "description": "班级ID"
        },
        "className": {
            "bsonType": "string",
            "description": "班级名称"
        },
        "completionTime": {
            "bsonType": "timestamp",
            "description": "评估完成时间"
        },
        "startTimestamp": {
            "bsonType": "timestamp",
            "description": "评估开始时间"
        },
        "lastUpdated": {
            "bsonType": "timestamp",
            "description": "最后修改时间"
        },
        "currentIndex": {
            "bsonType": "int",
            "description": "当前题目索引"
        },
        "duration": {
            "bsonType": "int",
            "minimum": 0,
            "description": "评估耗时（毫秒）"
        },
        "totalScore": {
            "bsonType": "int",
            "minimum": 0,
            "description": "评估总分"
        },
        "sectionScores": {
            "bsonType": "object",
            "description": "各维度得分",
            "additionalProperties": {
                "bsonType": "int",
                "minimum": 0
            }
        },
        "questions": {
            "bsonType": "array",
            "description": "评估时题目的快照",
            "items": {
                "bsonType": "object",
                "required": [
                    "_id",
                    "assessment_id",
                    "content",
                    "section"
                ],
                "properties": {
                    "_id": {
                        "bsonType": "string"
                    },
                    "assessment_id": {
                        "bsonType": "string"
                    },
                    "order": {
                        "bsonType": "int"
                    },
                    "type": {
                        "bsonType": "string"
                    },
                    "content": {
                        "bsonType": "string"
                    },
                    "section": {
                        "bsonType": "string"
                    },
                    "options": {
                        "bsonType": "array",
                        "items": {
                            "bsonType": "object",
                            "properties": {
                                "text": {
                                    "bsonType": "string"
                                },
                                "score": {
                                    "bsonType": "int"
                                }
                            }
                        }
                    },
                    "age_standards": {
                        "bsonType": "array",
                        "description": "(新增，可选) 题目对应各年龄段标准",
                        "items": {
                            "bsonType": "object",
                            "properties": {
                                "age": {
                                    "bsonType": "int"
                                },
                                "expected_score": {
                                    "bsonType": "int"
                                }
                            }
                        }
                    }
                }
            }
        },
        "answers": {
            "bsonType": "object",
            "description": "用户作答结果",
            "additionalProperties": {
                "bsonType": "object",
                "required": [
                    "score"
                ],
                "properties": {
                    "score": {
                        "bsonType": "int"
                    },
                    "question": {
                        "bsonType": "object",
                        "description": "题目快照"
                    },
                    "expectedScore": {
                        "bsonType": "int",
                        "description": "(新增，可选) 当前儿童年龄段期望得分"
                    },
                    "isPassed": {
                        "bsonType": "bool",
                        "description": "(新增，可选) 是否达标"
                    }
                }
            }
        },
        "uuid": {
            "bsonType": "string",
            "description": "评估记录唯一标识"
        },
        "aiSummary": {
            "bsonType": "object",
            "description": "(新增，可选) AI生成的简单总结",
            "properties": {
                "passedSections": {
                    "bsonType": "array",
                    "items": {
                        "bsonType": "string"
                    }
                },
                "needsImprovementSections": {
                    "bsonType": "array",
                    "items": {
                        "bsonType": "string"
                    }
                },
                "totalPassRate": {
                    "bsonType": "double"
                }
            }
        },
        "aiResponse": {
            "bsonType": "string",
            "description": "(新增，可选) 完整AI生成报告"
        },
        "pdfUrl": {
            "bsonType": "string",
            "description": "PDF文件云存储URL"
        },
        "pdfStatus": {
            "bsonType": "string",
            "enum": [
                "pending",
                "generating",
                "completed",
                "failed"
            ],
            "description": "PDF生成状态"
        },
        "pdfGeneratedTime": {
            "bsonType": "timestamp",
            "description": "PDF生成时间"
        },
        "reportId": {
            "bsonType": "string",
            "description": "报告唯一ID"
        },
        "reportVersion": {
            "bsonType": "string",
            "description": "报告版本"
        },
        "recordId": {
            "bsonType": "string",
            "description": "关联的评估记录ID"
        },
        "assessorId": {
            "bsonType": "string",
            "description": "评估师ID"
        },
        "assessorName": {
            "bsonType": "string",
            "description": "评估师昵称快照"
        },
        "avatar": {
            "bsonType": "string",
            "description": "学生头像"
        },
        "ageInt": {
            "bsonType": "int",
            "description": "学生年龄整数"
        },
        "assessmentTitle": {
            "bsonType": "string",
            "description": "评估量表标题"
        },
        "sectionSummaryList": {
            "bsonType": "array",
            "description": "各模块评估摘要列表"
        },
        "reportSummary": {
            "bsonType": "string",
            "description": "报告总结"
        },
        "createTime": {
            "bsonType": "timestamp",
            "description": "创建时间"
        },
        "updateTime": {
            "bsonType": "timestamp",
            "description": "更新时间"
        }
    }
}
