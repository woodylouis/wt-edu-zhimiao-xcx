{
	"bsonType": "object",
	"required": ["assessment_id", "section_id", "section", "order"],
	"properties": {
		"_id": {
			"description": "ID，系统自动生成"
		},
		"assessment_id": {
			"bsonType": "string",
			"description": "所属评估量表ID"
		},
		"order": {
			"bsonType": "int",
			"minimum": 0,
			"description": "排序"
		},
		"section_id": {
			"bsonType": "string",
			"description": "模块业务编码，需全局唯一",
			"pattern": "^[A-Z][A-Z0-9_]{1,29}$"
		},
		"section": {
			"bsonType": "string",
			"description": "模块名称"
		},
		"desc": {
			"bsonType": "string",
			"description": "模块说明"
		},
		"create_time": {
			"bsonType": "timestamp",
			"description": "创建时间",
			"defaultValue": {
				"$env": "now"
			}
		},
		"update_time": {
			"bsonType": "timestamp",
			"description": "最后更新时间"
		}
	}
}
