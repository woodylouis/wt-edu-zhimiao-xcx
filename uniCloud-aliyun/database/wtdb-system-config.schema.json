{
  "bsonType": "object",
  "required": ["configKey", "value"],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "ID，系统自动生成"
    },
    "configKey": {
      "bsonType": "string",
      "title": "配置键",
      "trim": "both"
    },
    "value": {
      "bsonType": "string",
      "title": "配置值",
      "trim": "both"
    },
    "nextAllowedAt": {
      "bsonType": "long",
      "title": "AI 请求下次可执行时间"
    },
    "updatedBy": {
      "bsonType": "string",
      "title": "更新人"
    },
    "createTime": {
      "bsonType": "long",
      "title": "创建时间"
    },
    "updateTime": {
      "bsonType": "long",
      "title": "更新时间"
    }
  }
}
