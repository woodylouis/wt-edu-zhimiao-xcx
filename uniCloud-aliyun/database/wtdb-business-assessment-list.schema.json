{
    "bsonType": "object",
    "required": [
        "title",
        "type",
        "is_active"
    ],
    "properties": {
        "_id": {
            "description": "量表ID"
        },
        "title": {
            "bsonType": "string",
            "title": "量表名称",
            "trim": "both"
        },
        "description": {
            "bsonType": "string",
            "title": "量表说明"
        },
        "type": {
            "bsonType": "string",
            "enum": [
                "regular",
                "on_demand"
            ],
            "title": "评估类型"
        },
        "frequency": {
            "bsonType": "int",
            "minimum": 1,
            "maximum": 120,
            "title": "定期评估间隔（月）"
        },
        "created_by": {
            "bsonType": "string",
            "foreignKey": "uni-id-users._id",
            "title": "创建者ID"
        },
        "created_time": {
            "bsonType": "timestamp",
            "defaultValue": {
                "$env": "now"
            },
            "title": "创建时间"
        },
        "update_time": {
            "bsonType": "timestamp",
            "title": "最后更新时间"
        },
        "is_active": {
            "bsonType": "bool",
            "defaultValue": false,
            "title": "是否启用"
        }
    },
    "validator": {
        "$or": [
            {
                "type": {
                    "$ne": "regular"
                }
            },
            {
                "type": "regular",
                "frequency": {
                    "$exists": true
                }
            }
        ]
    }
}
