// 文档教程: https://uniapp.dcloud.net.cn/uniCloud/schema
{
  "bsonType": "object",
  "required": [
    "nickname",
    "created_by",
    "code",
    "section",
    "grade",
    "class"
  ], // 新增必填字段
  "permission": {
    "read": "'admin' in auth.role || 'diana-admin' in auth.role || 'business-all' in auth.permission || doc.created_by == auth.uid",
    "create": "'admin' in auth.role || 'diana-admin' in auth.role || 'business-all' in auth.permission",
    "update": "'admin' in auth.role || 'diana-admin' in auth.role || 'business-all' in auth.permission",
    "delete": "'admin' in auth.role || 'diana-admin' in auth.role || 'business-all' in auth.permission"
  },
  "properties": {
    "_id": {
      "description": "班级ID"
    },
    "school_id": {
      "bsonType": "string",
      "title": "学校编号",
      "description": "关联的学校唯一编号"
    },
    "code": {
      "bsonType": "string",
      "title": "班级码",
      "pattern": "^\\d{6}$", // 强制6位纯数字
      "description": "唯一班级码（6位数字）",
      "unique": true // 强制全局唯一
    },
    "year": {
      "bsonType": "string",
      "title": "年份",
      "pattern": "^\\d{4}$",
      "description": "班级所属年份，例如2025"
    },
    "section": {
      "bsonType": "string",
      "title": "学段"
    },
    "grade": {
      "bsonType": "string",
      "title": "年级"
    },
    "class": {
      "bsonType": "string",
      "title": "班级"
    },
    "nickname": {
      "bsonType": "string",
      "title": "班级昵称"
    },
    "description": {
      "bsonType": "string",
      "title": "班级描述"
    },
    "remark": {
      "bsonType": "string",
      "title": "备注"
    },
    "teacherName": {
      "bsonType": "string",
      "title": "创建者老师名字"
    },
    "class_creator_teacher": {
      "bsonType": "string",
      "title": "创建者老师名字"
    },
    "head_teacher_user_id": {
      "bsonType": "string",
      "foreignKey": "uni-id-users._id",
      "title": "班主任用户ID",
      "description": "班主任的 uni-id 用户ID，可暂不指定"
    },
    "created_by": {
      "bsonType": "string",
      "foreignKey": "uni-id-users._id",
      "title": "创建者ID"
    },
    "create_time": {
      "bsonType": "timestamp",
      "defaultValue": {
        "$env": "now"
      },
      "title": "创建时间"
    }
  },
  "indexes": [
    {
      "name": "code_1", // 唯一索引（已通过unique:true自动创建）
      "key": {
        "code": 1
      }
    },
    {
      "name": "head_teacher_user_id_1",
      "key": {
        "head_teacher_user_id": 1
      }
    }
  ]
}
