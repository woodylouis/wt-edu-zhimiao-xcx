{
    "bsonType": "object",
    "required": [],
    "properties": {
        "_id": {
            "description": "记录ID"
        },
        "recordId": {
            "bsonType": "string",
            "description": "评估记录唯一标识"
        },
        "assessmentId": {
            "bsonType": "string",
            "description": "关联的评估量表ID"
        },
        "assessment_id": {
            "bsonType": "string",
            "description": "关联的评估量表ID"
        },
        "child_id": {
            "bsonType": "string",
            "description": "被评估儿童ID"
        },
        "childId": {
            "bsonType": "string",
            "description": "被评估儿童ID"
        },
        "childName": {
            "bsonType": "string",
            "description": "儿童姓名"
        },
        "assessorId": {
            "bsonType": "string",
            "description": "评估师ID"
        },
        "modulesStatus": {
            "bsonType": "array",
            "description": "模块完成状态列表",
            "items": {
                "bsonType": "object",
                "properties": {
                    "sectionId": {
                        "bsonType": "string",
                        "description": "模块ID"
                    },
                    "sectionName": {
                        "bsonType": "string",
                        "description": "模块名称"
                    },
                    "status": {
                        "bsonType": "int",
                        "description": "状态: 0-未开始/进行中, 1-已完成"
                    },
                    "sectionRecordId": {
                        "bsonType": "string",
                        "description": "模块记录ID"
                    },
                    "completedSubSections": {
                        "bsonType": "int",
                        "description": "已完成的子模块数量",
                        "defaultValue": 0
                    },
                    "totalSubSections": {
                        "bsonType": "int",
                        "description": "子模块总数"
                    },
                    "lastSubSectionIndex": {
                        "bsonType": "int",
                        "description": "上次做到的子模块索引",
                        "defaultValue": 0
                    },
                    "lastSubSectionId": {
                        "bsonType": "string",
                        "description": "最后访问的子模块ID"
                    },
                    "lastSubSectionName": {
                        "bsonType": "string",
                        "description": "最后访问的子模块名称"
                    },
                    "hasStarted": {
                        "bsonType": "bool",
                        "description": "是否已开始",
                        "defaultValue": false
                    },
                    "prefilledQuestions": {
                        "bsonType": "int",
                        "minimum": 0,
                        "description": "本模块历史预填题目数量"
                    },
                    "reviewedPrefilledQuestions": {
                        "bsonType": "int",
                        "minimum": 0,
                        "description": "本模块已复核历史预填题目数量"
                    },
                    "pendingPrefilledQuestions": {
                        "bsonType": "int",
                        "minimum": 0,
                        "description": "本模块待复核历史预填题目数量"
                    },
                    "subSectionsProgress": {
                        "bsonType": "array",
                        "description": "每个子模块的进度",
                        "items": {
                            "bsonType": "object",
                            "properties": {
                                "subSectionId": {
                                    "bsonType": "string",
                                    "description": "子模块ID"
                                },
                                "subSectionName": {
                                    "bsonType": "string",
                                    "description": "子模块名称"
                                },
                                "completedQuestions": {
                                    "bsonType": "int",
                                    "description": "已完成题目数",
                                    "defaultValue": 0
                                },
                                "totalQuestions": {
                                    "bsonType": "int",
                                    "description": "总题目数"
                                },
                                "isCompleted": {
                                    "bsonType": "bool",
                                    "description": "是否已完成",
                                    "defaultValue": false
                                }
                            }
                        }
                    }
                }
            }
        },
        "createTime": {
            "bsonType": "timestamp",
            "description": "创建时间"
        },
        "lastSaveTime": {
            "bsonType": "timestamp",
            "description": "上次保存时间"
        },
        "lastCompletedTime": {
            "bsonType": "timestamp",
            "description": "上次完成评估的时间"
        },
        "assessmentStatus": {
            "bsonType": "string",
            "enum": ["started", "in_progress", "completed", "abandoned"],
            "description": "当前评估批次状态"
        },
        "reportStatus": {
            "bsonType": "string",
            "enum": ["not_requested", "generating", "completed", "failed"],
            "description": "当前评估批次的报告状态"
        },
        "plannedEndTime": {
            "bsonType": "timestamp",
            "description": "计划完成时间，默认为开始后3天"
        },
        "nextReminderAt": {
            "bsonType": "timestamp",
            "description": "最后一次保存后24小时的提醒检查时间"
        },
        "reminderSentAt": {
            "bsonType": "timestamp",
            "description": "本次评估的未完成微信提醒发送时间"
        },
        "lastSectionId": {
            "bsonType": "string",
            "description": "上次做到的模块ID"
        },
        "isAbandoned": {
            "bsonType": "bool",
            "description": "是否因重新开始评估而停止使用",
            "defaultValue": false
        },
        "abandonedAt": {
            "bsonType": "timestamp",
            "description": "停止使用当前进度的时间"
        },
        "abandonReason": {
            "bsonType": "string",
            "description": "停止使用当前进度的原因"
        },
        "restartedFromRecordId": {
            "bsonType": "string",
            "description": "重新开始前的评估记录ID"
        },
        "prefillMode": {
            "bsonType": "string",
            "enum": [
                "history"
            ],
            "description": "新评估是否参考历史答题记录预填"
        },
        "prefilledFromRecordId": {
            "bsonType": "string",
            "description": "预填来源的已完成评估记录ID"
        },
        "prefilledAt": {
            "bsonType": "timestamp",
            "description": "历史答案预填时间"
        },
        "prefilledBy": {
            "bsonType": "string",
            "description": "发起历史答案预填的老师ID"
        },
        "prefillSourceCompletedAt": {
            "bsonType": "timestamp",
            "description": "预填来源评估的完成时间"
        },
        "prefilledQuestionCount": {
            "bsonType": "int",
            "minimum": 0,
            "description": "成功预填的历史答案数量"
        },
        "prefillTotalQuestionCount": {
            "bsonType": "int",
            "minimum": 0,
            "description": "新评估当前版本的题目总数"
        },
        "prefillReviewedQuestionCount": {
            "bsonType": "int",
            "minimum": 0,
            "description": "已经由老师确认或修改的历史预填答案数量"
        },
        "prefillPendingQuestionCount": {
            "bsonType": "int",
            "minimum": 0,
            "description": "尚未复核的历史预填答案数量"
        },
        "isCompleted": {
            "bsonType": "bool",
            "description": "是否已完成全部评估",
            "defaultValue": false
        }
    }
}
