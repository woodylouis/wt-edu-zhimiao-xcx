{
  "bsonType": "object",
  "required": [
    "class_id",
    "class_code",
    "class_name",
    "school_id",
    "school_name",
    "applicant_user_id",
    "applicant_name",
    "requested_role",
    "status",
    "apply_time"
  ],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": { "description": "审批记录ID" },
    "class_id": { "bsonType": "string", "title": "班级记录ID" },
    "class_code": { "bsonType": "string", "title": "班级码" },
    "class_name": { "bsonType": "string", "title": "班级名称" },
    "school_id": { "bsonType": "string", "title": "学校业务ID" },
    "school_name": { "bsonType": "string", "title": "学校名称" },
    "applicant_user_id": { "bsonType": "string", "title": "申请人用户ID" },
    "applicant_name": { "bsonType": "string", "title": "申请时昵称快照" },
    "applicant_mobile": { "bsonType": "string", "title": "申请人手机号" },
    "requested_role": {
      "bsonType": "string",
      "enum": ["teacher", "parent"],
      "title": "申请身份"
    },
    "nickname": { "bsonType": "string", "title": "班级内昵称" },
    "child_name": { "bsonType": "string", "title": "申请关联的儿童姓名" },
    "child_gender": {
      "bsonType": "string",
      "enum": ["男孩", "女孩"],
      "title": "申请关联的儿童性别"
    },
    "child_birthdate": { "bsonType": "timestamp", "title": "申请关联的儿童出生日期" },
    "relationship": {
      "bsonType": "string",
      "enum": ["father", "mother", "grandfather", "grandmother", "other"],
      "title": "申请人与儿童关系"
    },
    "status": {
      "bsonType": "string",
      "enum": ["pending", "approved", "rejected"],
      "title": "审批状态"
    },
    "apply_time": { "bsonType": "timestamp", "title": "申请时间" },
    "reviewer_user_id": { "bsonType": "string", "title": "审批人用户ID" },
    "reviewer_name": { "bsonType": "string", "title": "审批人昵称" },
    "review_remark": { "bsonType": "string", "title": "审批备注" },
    "review_time": { "bsonType": "timestamp", "title": "审批时间" },
    "update_time": { "bsonType": "timestamp", "title": "更新时间" }
  },
  "validator": {
    "$or": [
      { "requested_role": { "$ne": "parent" } },
      {
        "requested_role": "parent",
        "$and": [
          { "child_name": { "$exists": true } },
          { "child_gender": { "$in": ["男孩", "女孩"] } },
          { "child_birthdate": { "$exists": true } },
          { "relationship": { "$in": ["father", "mother", "grandfather", "grandmother", "other"] } }
        ]
      }
    ]
  },
  "indexes": [
    {
      "name": "status_apply_time",
      "key": { "status": 1, "apply_time": -1 }
    },
    {
      "name": "school_status_apply_time",
      "key": { "school_id": 1, "status": 1, "apply_time": -1 }
    },
    {
      "name": "class_status_apply_time",
      "key": { "class_id": 1, "status": 1, "apply_time": -1 }
    },
    {
      "name": "applicant_class_status",
      "key": { "applicant_user_id": 1, "class_id": 1, "status": 1 }
    },
    {
      "name": "applicant_parent_child_status",
      "key": {
        "applicant_user_id": 1,
        "class_id": 1,
        "requested_role": 1,
        "child_name": 1,
        "child_birthdate": 1,
        "status": 1
      }
    }
  ]
}
