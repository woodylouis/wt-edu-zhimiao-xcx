{
  "bsonType": "object",
  "required": [
    "name",
    "class_id",
    "birthdate"
  ],
  "permission": {
    "read": "auth.uid != null",
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "儿童ID"
    },
    "name": {
      "bsonType": "string",
      "title": "姓名"
    },
    "gender": {
      "bsonType": "string",
      "enum": [
        "male",
        "female",
        "unknown"
      ],
      "defaultValue": "unknown",
      "title": "性别"
    },
    "birthdate": {
      "bsonType": "timestamp",
      "title": "出生日期",
      "description": "存储时间戳用于计算年龄"
    },
    "age": {
      "bsonType": "string",
      "title": "年龄字符串",
      "description": "例如：4岁2个月"
    },
    "ageInt": {
      "bsonType": "int",
      "title": "年龄整数",
      "description": "用于评估标准匹配"
    },
    "formatBirthdate": {
      "bsonType": "string",
      "title": "格式化出生日期",
      "pattern": "^\\d{4}年\\d{2}月\\d{2}日$",
      "description": "前端直接显示的日期格式"
    },
    "class_id": {
      "bsonType": "string",
      "foreignKey": "class._id",
      "title": "所属班级ID"
    },
    "avatar": {
      "bsonType": "string",
      "title": "头像URL"
    }
  }
}