{
    "bsonType": "object",
    "required": [
        "assessment_id",
        "section_id",
        "type",
        "content",
        "options",
        "age_standards"
    ],
    "properties": {
        "_id": {
            "description": "题目ID"
        },
        "assessment_id": {
            "bsonType": "string",
            "description": "所属评估量表ID"
        },
        "section_id": {
            "bsonType": "string",
            "description": "所属模块业务编码"
        },
        "order": {
            "bsonType": "int",
            "minimum": 0,
            "description": "模块内排序"
        },
        "type": {
            "bsonType": "string",
            "enum": [
                "radio"
            ],
            "description": "当前小程序支持的题型"
        },
        "ablls_r_section": {
            "bsonType": "string",
            "description": "子分类名称"
        },
        "ablls_r_section_alphabet": {
            "bsonType": "string",
            "description": "子分类编码"
        },
        "ablls_r_section_order": {
            "bsonType": "int",
            "minimum": 0,
            "description": "子分类内排序"
        },
        "task_name": {
            "bsonType": "string",
            "description": "任务名称"
        },
        "task_name_eng": {
            "bsonType": "string",
            "description": "任务英文名称"
        },
        "task_object": {
            "bsonType": "string",
            "description": "任务目标"
        },
        "content": {
            "bsonType": "string",
            "description": "题干"
        },
        "task_sample": {
            "bsonType": "string",
            "description": "示例"
        },
        "description": {
            "bsonType": "string",
            "description": "备注"
        },
        "options": {
            "bsonType": "array",
            "description": "评分选项",
            "items": {
                "bsonType": "object",
                "required": [
                    "text",
                    "score"
                ],
                "properties": {
                    "text": {
                        "bsonType": "string",
                        "description": "选项文本"
                    },
                    "score": {
                        "bsonType": "int",
                        "minimum": 0,
                        "description": "选项得分"
                    }
                }
            }
        },
        "age_standards": {
            "bsonType": "array",
            "description": "各年龄的预期得分，0表示该年龄不展示题目",
            "items": {
                "bsonType": "object",
                "required": [
                    "age",
                    "expected_score"
                ],
                "properties": {
                    "age": {
                        "bsonType": "int",
                        "minimum": 0,
                        "maximum": 30,
                        "description": "年龄（岁）"
                    },
                    "expected_score": {
                        "bsonType": "int",
                        "minimum": 0,
                        "description": "预期得分"
                    }
                }
            }
        },
        "create_time": {
            "bsonType": "timestamp",
            "defaultValue": {
                "$env": "now"
            },
            "description": "创建时间"
        },
        "update_time": {
            "bsonType": "timestamp",
            "description": "最后更新时间"
        }
    }
}
