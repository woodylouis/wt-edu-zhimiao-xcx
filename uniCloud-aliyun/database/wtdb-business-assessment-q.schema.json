{
    "bsonType": "object",
    "required": [
        "assessment_id",
        "type",
        "content",
        "section"
    ],
    "properties": {
        "_id": {
            "description": "题目ID"
        },
        "assessment_id": {
            "bsonType": "string",
            "foreignKey": "assessment._id",
            "title": "所属量表ID"
        },
        "order": {
            "bsonType": "int",
            "title": "题目顺序"
        },
        "type": {
            "bsonType": "string",
            "enum": [
                "radio",
                "checkbox",
                "text"
            ],
            "defaultValue": "radio",
            "title": "题型"
        },
        "content": {
            "bsonType": "string",
            "title": "题目内容"
        },
        "section": {
            "bsonType": "string",
            "title": "所属章节",
            "description": "题目所属的章节或分类"
        },
        "options": {
            "bsonType": "array",
            "title": "选项",
            "items": {
                "bsonType": "object",
                "required": [
                    "text",
                    "score"
                ],
                "properties": {
                    "text": {
                        "bsonType": "string",
                        "title": "选项文本"
                    },
                    "score": {
                        "bsonType": "int",
                        "minimum": 0,
                        "title": "得分值",
                        "description": "选择该选项获得的分数"
                    }
                }
            }
        },
        "correct_answer": {
            "bsonType": "array",
            "title": "正确答案（选项索引）",
            "items": {
                "bsonType": "int"
            }
        },
        "score": {
            "bsonType": "int",
            "minimum": 0,
            "title": "题目分值"
        }
    }
}