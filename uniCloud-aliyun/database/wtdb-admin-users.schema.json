// 小程序用户权限表
{
	"bsonType": "object",
	"required": [
		"user_id",
		"role"
	],
	"properties": {
		"user_id": {
			"bsonType": "string",
			"foreignKey": "uni-id-users._id",
			"title": "用户ID"
		},
		"role": {
			"bsonType": "string",
			"enum": [
				"superAdmin",
				"classAdmin"
			],
			"title": "管理员角色"
		},
		"create_time": {
			"bsonType": "timestamp",
			"title": "授权时间",
			"defaultValue": {
				"$env": "now"
			}
		}
	}
}