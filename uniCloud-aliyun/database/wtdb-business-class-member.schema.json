{
  "bsonType": "object",
  "required": ["user_id", "class_id", "role"],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "班级成员关系ID"
    },
    "user_id": {
      "bsonType": "string",
      "foreignKey": "uni-id-users._id",
      "title": "用户ID"
    },
    "class_id": {
      "bsonType": "string",
      "foreignKey": "wtdb-business-class-list._id",
      "title": "班级ID"
    },
    "role": {
      "bsonType": "string",
      "enum": ["teacher", "parent"],
      "title": "班级身份"
    },
    "nickname": {
      "bsonType": "string",
      "title": "历史班级内称呼"
    },
    "person_id": {
      "bsonType": "string",
      "foreignKey": "wtdb-business-person._id",
      "title": "统一业务人员ID"
    },
    "display_name_override": {
      "bsonType": "string",
      "title": "班级内称呼覆盖"
    },
    "child_id": {
      "bsonType": "string",
      "foreignKey": "wtdb-business-children._id",
      "title": "关联儿童ID"
    },
    "relationship": {
      "bsonType": "string",
      "enum": ["father", "mother", "grandfather", "grandmother", "other"],
      "title": "与儿童关系"
    },
    "join_time": {
      "bsonType": "timestamp",
      "title": "加入时间"
    },
    "approved_by": {
      "bsonType": "string",
      "title": "审批人用户ID"
    },
    "approval_id": {
      "bsonType": "string",
      "title": "入班审批记录ID"
    }
  },
  "validator": {
    "$or": [
      {
        "role": {
          "$ne": "parent"
        }
      },
      {
        "role": "parent",
        "$and": [
          {
            "child_id": {
              "$exists": true
            }
          },
          {
            "relationship": {
              "$in": ["father", "mother", "grandfather", "grandmother", "other"]
            }
          }
        ]
      }
    ]
  },
  "indexes": [
    {
      "name": "user_class",
      "key": {
        "user_id": 1,
        "class_id": 1
      }
    },
    {
      "name": "class_role",
      "key": {
        "class_id": 1,
        "role": 1
      }
    },
    {
      "name": "person_class",
      "key": {
        "person_id": 1,
        "class_id": 1
      }
    }
  ]
}
