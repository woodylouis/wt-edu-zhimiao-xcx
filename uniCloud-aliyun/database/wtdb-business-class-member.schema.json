// 文档教程: https://uniapp.dcloud.net.cn/uniCloud/schema
{
  "bsonType": "object",
  "required": ["user_id", "class_id", "role"],
  "properties": {
    "_id": { "description": "ID" },
    "user_id": { 
      "bsonType": "string", 
      "foreignKey": "uni-id-users._id",
      "title": "用户ID" 
    },
    "class_id": { 
      "bsonType": "string", 
      "foreignKey": "class._id",
      "title": "班级ID" 
    },
    "role": { 
      "bsonType": "string", 
      "enum": ["teacher", "parent"],
      "title": "角色" 
    },
    "child_id": { 
      "bsonType": "string", 
      "foreignKey": "child._id",
      "title": "关联的儿童ID（仅家长角色必填）" 
    }
  },
  "validator": { // 家长角色必须关联孩子
    "$or": [
      { "role": { "$ne": "parent" } },
      { "role": "parent", "child_id": { "$exists": true } }
    ]
  }
}