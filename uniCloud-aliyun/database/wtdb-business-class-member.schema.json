{
  "bsonType": "object",
  "required": [
    "user_id",
    "class_id",
    "role"
  ],
  "properties": {
    "_id": {
      "description": "ID"
    },
    "user_id": {
      "bsonType": "string",
      "foreignKey": "uni-id-users._id",
      "title": "用户ID"
    },
    "class_id": {
      "bsonType": "string",
      "foreignKey": "class._id",
      "title": "班级ID"
    },
    "role": {
      "bsonType": "string",
      "enum": [
        "teacher",
        "parent"
      ],
      "title": "角色"
    },
    "child_id": {
      "bsonType": "string",
      "foreignKey": "child._id",
      "title": "关联的儿童ID（仅家长角色必填）"
    },
    "relationship": {
      "bsonType": "string",
      "title": "家庭成员关系",
      "enum": [
        "father",
        "mother",
        "grandfather",
        "grandmother",
        "other"
      ],
      "description": "仅家长角色需要，枚举：父亲、母亲、爷爷、奶奶、其他"
    }
  },
  "validator": {
    "$or": [
      {
        "role": {
          "$ne": "parent"
        }
      },
      {
        "role": "parent",
        "$and": [
          {
            "child_id": {
              "$exists": true
            }
          },
          {
            "relationship": {
              "$in": [
                "father",
                "mother",
                "grandfather",
                "grandmother",
                "other"
              ]
            }
          }
        ]
      }
    ]
  }
}